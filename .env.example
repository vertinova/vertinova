FINANCE_API_PORT=8787
FRONTEND_ORIGIN=https://vertinova.id
API_BASE_URL=https://vertinova.id

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=vertinova_finance
DATABASE_URL=mysql://root@127.0.0.1:3306/vertinova_finance

SUPER_ADMIN_NAME=Super Admin
SUPER_ADMIN_USERNAME=serigala
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=firewall22
SESSION_TTL_HOURS=12

# Isi dengan endpoint saldo masuk resmi dari Simpaskor.
SIMPASKOR_API_BASE_URL=https://simpaskor.id
SIMPASKOR_BALANCE_URL=/api/external/admin-fees?includeDetails=true
# Endpoint bagi hasil platform + pembayaran paket. Total Saldo Simpaskor =
# admin fee + platform share + package payments.
SIMPASKOR_PLATFORM_REVENUE_URL=/api/external/platform-revenue?includeDetails=true
# Opsional. Kosongkan agar saldo Simpaskor diambil tanpa batas tahun.
SIMPASKOR_BALANCE_FROM=
SIMPASKOR_BALANCE_TO=
SIMPASKOR_API_KEY=
SIMPASKOR_API_KEY_HEADER=X-API-Key
# Khusus webhook admin fee Simpaskor. Jika kosong, fallback ke SIMPASKOR_API_KEY.
SIMPASKOR_ADMIN_FEE_API_KEY=

# Endpoint Forbasi KTA.
FORBASI_BALANCE_URL=/api/external/kta/payment-config
FORBASI_API_KEY=
FORBASI_API_KEY_HEADER=X-API-Key

# Webhook otomatis:
# POST /api/finance/webhooks/simpaskor dengan header X-API-Key
# POST /api/finance/webhooks/forbasi dengan header FORBASI_API_KEY_HEADER
